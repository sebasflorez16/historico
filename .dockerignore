# .dockerignore - Archivos a excluir del build de Docker
# Esto acelera el build y reduce el tamaño de la imagen

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Testing
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Documentación
*.md
docs/
*.txt
!requirements.txt

# Archivos de prueba
test_*.py
*_test.py

# Archivos temporales
*.tmp
*.bak
*.swp

# ============================================
# ARCHIVOS PESADOS - NO subir a Railway
# ============================================

# Datos geográficos (shapefiles ~437MB) - se cargan por separado
datos_geograficos/

# PDFs generados de prueba
*.pdf
informes_generados/

# Outputs de test
test_outputs/
test_outputs_mapas/

# Carpeta historical (backup antiguo)
historical/

# Scripts de diagnóstico y prueba (no necesarios en producción)
diagnostico_*.py
verificar_*.py
corregir_*.py
configurar_*.py
generar_video*.py
generar_pdf_*.py
auditar_*.py
listar_*.py
regenerar_*.py
create_superuser.py

# Archivos de deploy/docs no necesarios
deploy_*.sh
*.txt
!requirements.txt
invitacion_real.txt
