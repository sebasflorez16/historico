# .dockerignore - Archivos a excluir del build de Docker
# REGLA CRÍTICA: !requirements.txt debe ir AL FINAL después de *.txt

# ============================================
# ARCHIVOS PESADOS - Excluir primero
# ============================================
datos_geograficos/
historical/
.venv/
venv/
env/
ENV/
.git/
test_outputs/
test_outputs_mapas/
informes_generados/
media/
staticfiles/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Testing
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# PDFs generados
*.pdf

# Documentación y texto (excluir)
*.md
docs/
*.txt

# RE-INCLUIR requirements.txt (CRÍTICO - debe ser la ÚLTIMA regla sobre .txt)
!requirements.txt

# Scripts no necesarios en producción
diagnostico_*.py
verificar_*.py
corregir_*.py
configurar_*.py
generar_video*.py
generar_pdf_*.py
auditar_*.py
listar_*.py
regenerar_*.py
create_superuser.py
test_*.py
*_test.py
deploy_*.sh
